{
  "name": "pipeline-diagrams",
  "version": "0.2.5",
  "description": "Diagrams as code for data pipelines: generate whiteboard-proof diagrams from text in your docs, CI and AI agents. Renderer, Mermaid converter, web component, Markdown plugins and an MCP server.",
  "license": "MIT",
  "author": {
    "name": "Wilco van Duinkerken",
    "url": "https://www.sparkboxx.com"
  },
  "type": "module",
  "homepage": "https://pipeline-diagrams.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sparkboxx/pipeline-modelling.git"
  },
  "bugs": {
    "url": "https://github.com/Sparkboxx/pipeline-modelling/issues"
  },
  "keywords": [
    "diagrams-as-code",
    "diagram",
    "data-pipeline",
    "architecture",
    "ai-agents",
    "mcp",
    "mermaid",
    "svg",
    "markdown"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./scripts/pipeline-dsl.mjs",
    "./mermaid": "./scripts/pipeline-mermaid.mjs",
    "./browser": "./scripts/pipeline-browser.mjs",
    "./bundle": "./assets/js/pipeline-diagrams.js",
    "./html": "./integrations/html.mjs",
    "./markdown-it": "./integrations/markdown-it.mjs",
    "./remark": "./integrations/remark.mjs",
    "./icons.json": "./downloads/pipeline-diagrams-icons.json",
    "./viewer.html": "./downloads/pipeline-diagrams-viewer.html"
  },
  "bin": {
    "pipeline-diagrams": "scripts/render-pipeline.mjs",
    "pipeline-diagrams-markdown": "scripts/render-markdown.mjs",
    "pipeline-diagrams-mcp": "integrations/mcp/server.mjs"
  },
  "files": [
    "scripts/shapes.mjs",
    "scripts/pipeline-dsl.mjs",
    "scripts/pipeline-mermaid.mjs",
    "scripts/pipeline-browser.mjs",
    "scripts/render-pipeline.mjs",
    "scripts/render-markdown.mjs",
    "assets/js/pipeline-diagrams.js",
    "integrations/",
    "downloads/pipeline-diagrams-icons.json",
    "downloads/pipeline-diagrams-viewer.html"
  ],
  "scripts": {
    "test": "node --test scripts/test/*.test.mjs",
    "build": "node scripts/diagrams.mjs images && node scripts/templates.mjs downloads"
  }
}
